              <th className="py-4 px-5">Tài khoản / Người dùng</th>
              <th className="py-4 px-4">Vai trò (Role)</th>
              <th className="py-4 px-4">Phòng ban</th>
              <th className="py-4 px-4">Trạng thái</th>
              <th className="py-4 px-4">Ngày đăng ký</th>
              <th className="py-4 px-5 text-right">Hành động</th>
            </tr>
          </thead>
          <tbody className="divide-y divide-slate-800/60 text-xs">
            {users.map((user) => {
              const isCurrentAdmin = currentAdminEmail && user.email.toLowerCase() === currentAdminEmail.toLowerCase()
              const initials = user.fullName
                ? user.fullName
                    .split(' ')
                    .filter(Boolean)
                    .map((n) => n[0])
                    .join('')
                    .slice(0, 2)
                    .toUpperCase()
                : user.email.slice(0, 2).toUpperCase()

              return (
                <tr
                  key={user.id}
                  className={`hover:bg-slate-800/40 transition-colors group ${
                    user.status === 'banned'
                      ? 'opacity-60 bg-rose-950/10'
                      : user.status === 'inactive'
                      ? 'opacity-75 bg-amber-950/10'
                      : ''
                  }`}
                >
                  {/* User Profile / Avatar / Email */}
                  <td className="py-4 px-5">
                    <div className="flex items-center gap-3">
                      <div
                        className={`w-9 h-9 rounded-xl flex items-center justify-center font-bold text-xs border shrink-0 ${
                          user.role === 'admin'
                            ? 'bg-purple-950/80 border-purple-500/40 text-purple-300 shadow-sm'
                            : 'bg-blue-950/80 border-blue-500/40 text-blue-300 shadow-sm'
                        }`}
                      >
                        {initials}
                      </div>
                      <div className="min-w-0">
                        <div className="flex items-center gap-2">
                          <span className="font-bold text-white group-hover:text-indigo-300 transition-colors truncate">
                            {user.fullName || 'Chưa cập nhật tên'}
                          </span>
                          {isCurrentAdmin && (
                            <span className="text-[10px] px-1.5 py-0.2 rounded bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 font-semibold">
                              Bạn
                            </span>
                          )}
                        </div>
                        <p className="text-[11px] text-slate-400 truncate">{user.email}</p>
                      </div>
                    </div>
                  </td>

                  {/* Role Badge */}
                  <td className="py-4 px-4">
                    {user.role === 'admin' ? (
                      <span className="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-xl bg-purple-500/15 border border-purple-500/30 text-purple-300 text-[11px] font-bold">
                        <ShieldCheck className="w-3.5 h-3.5 text-purple-400" />
                        <span>Quản trị viên (Admin)</span>
                      </span>
                    ) : (
                      <span className="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-xl bg-blue-500/15 border border-blue-500/30 text-blue-300 text-[11px] font-bold">
                        <UserCheck className="w-3.5 h-3.5 text-blue-400" />
                        <span>Nhân viên (User)</span>
                      </span>
                    )}
                  </td>

                  {/* Department */}
                  <td className="py-4 px-4">
                    <div className="flex items-center gap-1.5 text-slate-300">
                      <Building className="w-3.5 h-3.5 text-slate-500 shrink-0" />
                      <span className="truncate">{user.department || 'Chưa phân bổ'}</span>
                    </div>
                  </td>

                  {/* Status Badge (3 states: active, inactive, banned) */}
                  <td className="py-4 px-4">
                    {user.status === 'active' && (
                      <span className="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-[11px] font-semibold">
                        <span className="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse" />
                        <span>Hoạt động</span>
                      </span>
                    )}
                    {user.status === 'inactive' && (
                      <span className="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-[11px] font-semibold">
                        <Clock className="w-3 h-3 text-amber-400" />
                        <span>Tạm ngưng</span>
                      </span>
                    )}
                    {user.status === 'banned' && (
                      <span className="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-rose-500/10 border border-rose-500/20 text-rose-400 text-[11px] font-semibold">
                        <Ban className="w-3 h-3 text-rose-400" />
                        <span>Đã khóa</span>
                      </span>
                    )}
                  </td>

                  {/* Created Date */}
                  <td className="py-4 px-4 text-slate-400 text-[11px]">
                    <div className="flex items-center gap-1.5">
                      <Calendar className="w-3.5 h-3.5 text-slate-500 shrink-0" />
                      <span>{user.createdAt ? new Date(user.createdAt).toLocaleDateString('vi-VN') : 'Không rõ'}</span>
                    </div>
                  </td>

                  {/* Action Buttons */}
                  <td className="py-4 px-5 text-right">
                    <div className="flex items-center justify-end gap-1.5">
                      {/* Edit Button */}
                      <button
                        onClick={() => onEdit(user)}
                        className="p-1.5 rounded-lg bg-slate-800/80 hover:bg-indigo-600 hover:text-white text-slate-300 border border-slate-700 hover:border-indigo-500 transition-all"
                        title="Chỉnh sửa thông tin, Vai trò & Trạng thái"
                      >
                        <Edit2 className="w-3.5 h-3.5" />
                      </button>

                      {/* Toggle Quick Status */}
                      {!isCurrentAdmin && (
                        <button
                          onClick={() => onToggleStatus(user)}
                          className={`p-1.5 rounded-lg border transition-all ${
                            user.status === 'active'
                              ? 'bg-slate-800/80 hover:bg-rose-600 hover:text-white text-rose-400 border-slate-700 hover:border-rose-500'
                              : 'bg-slate-800/80 hover:bg-emerald-600 hover:text-white text-emerald-400 border-slate-700 hover:border-emerald-500'
                          }`}
                          title={user.status === 'active' ? 'Khóa tài khoản (Banned)' : 'Mở khóa kích hoạt (Active)'}
                        >
                          {user.status === 'active' ? (
                            <Ban className="w-3.5 h-3.5" />
                          ) : (
                            <CheckCircle className="w-3.5 h-3.5" />
                          )}
                        </button>
                      )}

                      {/* Modal Manage Status & Delete */}
                      {!isCurrentAdmin && (
                        <button
                          onClick={() => onDelete(user)}
                          className="p-1.5 rounded-lg bg-slate-800/80 hover:bg-rose-600 hover:text-white text-rose-400 border border-slate-700 hover:border-rose-500 transition-all"
                          title="Khóa hoặc xóa tài khoản"
                        >
                          <Trash2 className="w-3.5 h-3.5" />
                        </button>
                      )}
                    </div>
                  </td>
                </tr>
              )
            })}
          </tbody>
        </table>
      </div>
    </div>
  )
}
</file>

<file path="app/admin/components/WarrantyDetailModal.tsx">
import React from 'react'
import { WarrantyReminder, WarrantyStatus, WARRANTY_STATUS_LABELS } from '../types/warranty'
import { getWarningBadgeInfo, formatVNDate } from '../utils/warrantyFormatters'
import { formatVND } from '../utils/formatters'
import {
  X,
  Wrench,
  Building,
  MapPin,
  Calendar,
  Clock,
  CheckCircle2,
  AlertTriangle,
  AlertCircle,
  FileText,
  DollarSign,
  Tag,
  Hash
} from 'lucide-react'

interface WarrantyDetailModalProps {
  item: WarrantyReminder | null
  warningThreshold?: number
  overdueThreshold?: number
  onClose: () => void
  onUpdateStatus?: (item: WarrantyReminder, newStatus: WarrantyStatus) => void
}

export const WarrantyDetailModal: React.FC<WarrantyDetailModalProps> = ({
  item,
  warningThreshold = 7,
  overdueThreshold = 10,
  onClose,
  onUpdateStatus
}) => {
  if (!item) return null

  const warningInfo = getWarningBadgeInfo(item, warningThreshold, overdueThreshold)
  const statusCfg = WARRANTY_STATUS_LABELS[item.status] || {
    label: item.status,
    color: 'text-slate-300',
    bg: 'bg-slate-800 border-slate-700'
  }

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-md overflow-y-auto">
      <div className="relative w-full max-w-xl bg-slate-900 border border-slate-800 rounded-3xl shadow-2xl overflow-hidden my-8 animate-in fade-in zoom-in-95 duration-200">
        {/* Header */}
        <div className="flex items-center justify-between px-6 py-4 border-b border-slate-800 bg-slate-950/60">
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 rounded-2xl bg-indigo-600/20 border border-indigo-500/30 flex items-center justify-center text-indigo-400">
              <Wrench className="w-5 h-5" />
            </div>
            <div>
              <div className="flex items-center gap-2">
                <span className="text-[11px] font-mono font-bold text-indigo-400 bg-indigo-500/10 px-2 py-0.5 rounded-md border border-indigo-500/20">
                  STT: #{item.stt}
                </span>
                <span
                  className={`text-[11px] font-semibold px-2 py-0.5 rounded-full border ${statusCfg.bg} ${statusCfg.color}`}
                >
                  {statusCfg.label}
                </span>
              </div>
              <h3 className="text-base font-bold text-white mt-0.5">{item.productName}</h3>
            </div>
          </div>
          <button
            onClick={onClose}
            className="p-2 text-slate-400 hover:text-white rounded-xl hover:bg-slate-800 transition-colors"
          >
            <X className="w-5 h-5" />
          </button>
        </div>

        {/* Content Body */}
        <div className="p-6 space-y-5 text-xs">
          {/* Warning Banner */}
          <div className={`p-4 rounded-2xl border flex items-start gap-3 ${warningInfo.badgeClass}`}>
            {warningInfo.level === 'overdue' && (
              <AlertCircle className="w-5 h-5 text-rose-400 shrink-0 mt-0.5 animate-bounce" />
            )}
            {warningInfo.level === 'warning' && (
              <AlertTriangle className="w-5 h-5 text-amber-400 shrink-0 mt-0.5" />
            )}
            {warningInfo.level === 'completed' && (
              <CheckCircle2 className="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" />
            )}
            {warningInfo.level === 'normal' && (
              <Clock className="w-5 h-5 text-sky-400 shrink-0 mt-0.5" />
            )}
            <div>
              <h4 className="font-bold text-sm mb-0.5">{warningInfo.label}</h4>
              <p className="text-[11px] opacity-90 leading-relaxed">
                {warningInfo.level === 'overdue'
                  ? `Thiết bị đã mang qua NPP hơn ${overdueThreshold} ngày nhưng chưa hoàn thành. Quản trị viên cần liên hệ trực tiếp với NPP ${item.supplier} để giải quyết khẩn cấp.`
                  : warningInfo.level === 'warning'
                  ? `Thiết bị đã mang qua NPP từ ${warningThreshold} đến ${overdueThreshold} ngày. Vui lòng gọi điện hoặc nhắn tin cho NPP ${item.supplier} để giục trả hàng.`
                  : warningInfo.level === 'completed'
                  ? `Thiết bị đã hoàn tất quy trình bảo hành/sửa chữa và sẵn sàng bàn giao.`
                  : `Thiết bị đang trong thời gian xử lý bình thường tại NPP ${item.supplier}.`}
              </p>
            </div>
          </div>

          {/* Grid Info */}
          <div className="grid grid-cols-2 gap-3 bg-slate-950/60 p-4 rounded-2xl border border-slate-800/80">
            <div>
              <span className="text-[10px] text-slate-400 block mb-0.5">Mã Sản Phẩm</span>
              <strong className="text-slate-200 font-mono text-xs">{item.productCode}</strong>
            </div>

            <div>
              <span className="text-[10px] text-slate-400 block mb-0.5">Serial Number (S/N)</span>
              <strong className="text-slate-100 font-mono text-xs">{item.serialNumber}</strong>
            </div>

            {item.imei && (
              <div>
                <span className="text-[10px] text-slate-400 block mb-0.5">IMEI</span>
                <strong className="text-slate-300 font-mono text-xs">{item.imei}</strong>
              </div>
            )}

            <div>
              <span className="text-[10px] text-slate-400 block mb-0.5">Nơi gửi về</span>
              <div className="flex items-center gap-1.5 text-slate-200 font-semibold">
                <MapPin className="w-3.5 h-3.5 text-indigo-400" />
                <span>{item.location}</span>
              </div>
            </div>

            <div>
              <span className="text-[10px] text-slate-400 block mb-0.5">Nhà Phân Phối (NPP)</span>
              <div className="flex items-center gap-1.5 text-slate-200 font-semibold">
                <Building className="w-3.5 h-3.5 text-purple-400" />
                <span>{item.supplier}</span>
              </div>
            </div>

            {item.rmaCode && (
              <div>
                <span className="text-[10px] text-slate-400 block mb-0.5">Mã phiếu RMA của NPP</span>
                <strong className="text-purple-300 font-mono text-xs">{item.rmaCode}</strong>
              </div>
            )}

            {typeof item.cost === 'number' && item.cost > 0 && (
              <div>
                <span className="text-[10px] text-slate-400 block mb-0.5">Chi phí sửa chữa</span>
                <strong className="text-emerald-400 font-bold text-xs">{formatVND(item.cost)}</strong>
              </div>
            )}
          </div>

          {/* Timeline Dates */}
          <div className="space-y-2">
            <h5 className="font-bold text-slate-300 flex items-center gap-1.5">
              <Calendar className="w-3.5 h-3.5 text-indigo-400" />
              Mốc thời gian xử lý
            </h5>
            <div className="grid grid-cols-2 sm:grid-cols-4 gap-2 text-[11px]">
              <div className="bg-slate-950 p-2.5 rounded-xl border border-slate-800">
                <span className="text-slate-500 block text-[10px]">Tiếp nhận về kho</span>
                <strong className="text-slate-200 font-mono">{formatVNDate(item.receivedDate)}</strong>
              </div>

              <div className="bg-slate-950 p-2.5 rounded-xl border border-slate-800">
                <span className="text-slate-500 block text-[10px]">Mang qua NPP</span>
                <strong className="text-indigo-300 font-mono">
                  {formatVNDate(item.sentToSupplierDate || item.receivedDate)}
                </strong>
              </div>

              <div className="bg-slate-950 p-2.5 rounded-xl border border-slate-800">
                <span className="text-slate-500 block text-[10px]">Hẹn trả dự kiến</span>
                <strong className="text-slate-200 font-mono">{formatVNDate(item.expectedReturnDate)}</strong>
              </div>

              <div className="bg-slate-950 p-2.5 rounded-xl border border-slate-800">
                <span className="text-slate-500 block text-[10px]">Hoàn thành thực tế</span>
                <strong className="text-emerald-400 font-mono">{formatVNDate(item.completedDate)}</strong>
              </div>
            </div>
          </div>

          {/* Notes */}
          {item.notes && (
            <div className="space-y-1.5 bg-slate-950 p-3.5 rounded-2xl border border-slate-800">
              <span className="text-[10px] text-slate-400 font-semibold block">Ghi chú tình trạng lỗi:</span>
              <p className="text-slate-300 whitespace-pre-wrap leading-relaxed">{item.notes}</p>
            </div>
          )}

          {/* Quick Status Change */}
          {onUpdateStatus && (
            <div className="pt-2 border-t border-slate-800 flex items-center justify-between gap-3">
              <span className="text-slate-400 text-xs">Cập nhật nhanh trạng thái:</span>
              <select
                value={item.status}
                onChange={(e) => onUpdateStatus(item, e.target.value as WarrantyStatus)}
                className="bg-slate-950 border border-slate-700 focus:border-indigo-500 rounded-xl py-1.5 px-3 text-xs text-slate-200 outline-none"
              >
                {Object.entries(WARRANTY_STATUS_LABELS).map(([k, { label }]) => (
                  <option key={k} value={k}>
                    {label}
                  </option>
                ))}
              </select>
            </div>
          )}
        </div>

        {/* Footer */}
        <div className="flex items-center justify-end px-6 py-3.5 border-t border-slate-800 bg-slate-950/40">
          <button
            onClick={onClose}
            className="px-5 py-2 rounded-xl bg-slate-800 hover:bg-slate-750 text-white text-xs font-semibold transition-colors"
          >
            Đóng cửa sổ
          </button>
        </div>
      </div>
    </div>
  )
}
</file>

<file path="app/admin/components/WarrantyFilters.tsx">
import React from 'react'
import { WarrantyFilterTab, WarrantyStats, WarrantyStatus, WARRANTY_STATUS_LABELS } from '../types/warranty'
import { Search, RotateCcw, AlertTriangle, Clock, CheckCircle2, Filter } from 'lucide-react'

interface WarrantyFiltersProps {
  stats: WarrantyStats
  totalFiltered: number
  activeTab: WarrantyFilterTab
  onTabChange: (tab: WarrantyFilterTab) => void
  selectedLocation: string
  onLocationChange: (location: string) => void
  selectedSupplier: string
  onSupplierChange: (supplier: string) => void
  selectedStatus: string
  onStatusChange: (status: string) => void
  searchTerm: string
  onSearchChange: (term: string) => void
  locationOptions: string[]
  supplierOptions: string[]
  onResetFilters: () => void
}

export const WarrantyFilters: React.FC<WarrantyFiltersProps> = ({
  stats,
  totalFiltered,
  activeTab,
  onTabChange,
  selectedLocation,
  onLocationChange,
  selectedSupplier,
  onSupplierChange,
  selectedStatus,
  onStatusChange,
  searchTerm,
  onSearchChange,
  locationOptions,
  supplierOptions,
  onResetFilters,
}) => {
  const isFiltered =
    searchTerm !== '' ||
    selectedLocation !== 'Tất cả' ||
    selectedSupplier !== 'Tất cả' ||
    selectedStatus !== 'Tất cả' ||
    activeTab !== 'all'

  const urgentTotal = stats.warningCount + stats.overdueCount

  return (
    <div className="bg-slate-900/80 border border-slate-800/80 rounded-3xl p-5 mb-6 space-y-4 shadow-xl shadow-black/20">
      {/* 1. Quick Tabs Filter */}
      <div className="flex flex-wrap items-center justify-between gap-3 border-b border-slate-800/80 pb-4">
        <div className="flex flex-wrap items-center gap-2">
          {/* Tab: All */}
          <button
            onClick={() => onTabChange('all')}
            className={`px-3.5 py-2 rounded-xl text-xs font-semibold transition-all flex items-center gap-2 ${
              activeTab === 'all'
                ? 'bg-indigo-600 text-white shadow-lg shadow-indigo-600/30 font-bold'
                : 'bg-slate-800/80 text-slate-300 hover:bg-slate-750 hover:text-white'
            }`}
          >
            <span>Tất cả</span>
            <span
              className={`text-[10px] px-1.5 py-0.5 rounded-md font-mono ${
                activeTab === 'all' ? 'bg-white/20 text-white' : 'bg-slate-700 text-slate-300'
              }`}
            >
              {stats.total}
            </span>
          </button>

          {/* Tab: Urgent Warning (7-10d & >10d) */}
          <button
            onClick={() => onTabChange('urgent')}
            className={`px-3.5 py-2 rounded-xl text-xs font-semibold transition-all flex items-center gap-2 ${
              activeTab === 'urgent'
                ? 'bg-rose-600 text-white shadow-lg shadow-rose-600/30 font-bold'
                : 'bg-slate-800/80 text-rose-300 hover:bg-rose-500/10 hover:text-rose-200 border border-rose-500/20'
            }`}
          >
            <AlertTriangle className="w-3.5 h-3.5" />
            <span>Cần xử lý gấp</span>
            {urgentTotal > 0 && (
              <span
                className={`text-[10px] px-1.5 py-0.5 rounded-md font-mono font-bold ${
                  activeTab === 'urgent'
                    ? 'bg-white/20 text-white'
                    : 'bg-rose-500/20 text-rose-300 animate-pulse'
                }`}
              >
                {urgentTotal}
              </span>
            )}
          </button>

          {/* Tab: In Supplier / In NPP */}
          <button
            onClick={() => onTabChange('in_npp')}
            className={`px-3.5 py-2 rounded-xl text-xs font-semibold transition-all flex items-center gap-2 ${
              activeTab === 'in_npp'
                ? 'bg-sky-600 text-white shadow-lg shadow-sky-600/30 font-bold'
                : 'bg-slate-800/80 text-slate-300 hover:bg-slate-750 hover:text-white'
            }`}
          >
            <Clock className="w-3.5 h-3.5" />
            <span>Đang ở NPP</span>
            <span
              className={`text-[10px] px-1.5 py-0.5 rounded-md font-mono ${
                activeTab === 'in_npp' ? 'bg-white/20 text-white' : 'bg-slate-700 text-slate-300'
              }`}
            >
              {stats.inNpp}
            </span>
          </button>

          {/* Tab: Completed */}
          <button
            onClick={() => onTabChange('completed')}
            className={`px-3.5 py-2 rounded-xl text-xs font-semibold transition-all flex items-center gap-2 ${
              activeTab === 'completed'
                ? 'bg-emerald-600 text-white shadow-lg shadow-emerald-600/30 font-bold'
                : 'bg-slate-800/80 text-slate-300 hover:bg-slate-750 hover:text-white'
            }`}
          >
            <CheckCircle2 className="w-3.5 h-3.5" />
            <span>Đã hoàn thành</span>
            <span
              className={`text-[10px] px-1.5 py-0.5 rounded-md font-mono ${
                activeTab === 'completed' ? 'bg-white/20 text-white' : 'bg-slate-700 text-slate-300'
              }`}
            >
              {stats.completedCount}
            </span>
          </button>
        </div>

        {/* Filtered Count indicator */}
        <div className="text-xs text-slate-400 font-medium">
          Hiển thị <strong className="text-white font-bold">{totalFiltered}</strong> / {stats.total} phiếu
        </div>
      </div>

      {/* 2. Controls & Dropdowns */}
      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        {/* Search Input */}
        <div className="relative">
          <Search className="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-500" />
          <input
            type="text"
            value={searchTerm}
            onChange={(e) => onSearchChange(e.target.value)}
            placeholder="Tìm theo Tên SP, IMEI, S/N, NPP..."
            className="w-full bg-slate-950 border border-slate-800 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 rounded-xl py-2.5 pl-10 pr-4 text-xs text-white placeholder-slate-500 outline-none transition-all"
          />
        </div>

        {/* Location Filter */}
        <div>
          <select
            value={selectedLocation}
            onChange={(e) => onLocationChange(e.target.value)}
            className="w-full bg-slate-950 border border-slate-800 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 rounded-xl py-2.5 px-3 text-xs text-slate-200 outline-none transition-all"
          >
            <option value="Tất cả">Nơi gửi về (Tất cả)</option>
            {locationOptions.map((loc) => (
              <option key={loc} value={loc}>
                {loc}
              </option>
            ))}
          </select>
        </div>

        {/* Supplier / NPP Filter */}
        <div>
          <select
            value={selectedSupplier}
            onChange={(e) => onSupplierChange(e.target.value)}
            className="w-full bg-slate-950 border border-slate-800 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 rounded-xl py-2.5 px-3 text-xs text-slate-200 outline-none transition-all"
          >
            <option value="Tất cả">Nhà Phân Phối / NPP (Tất cả)</option>
            {supplierOptions.map((sup) => (
              <option key={sup} value={sup}>
                {sup}
              </option>
            ))}
          </select>
        </div>

        {/* Status Filter & Reset Button */}
        <div className="flex items-center gap-2">
          <select
            value={selectedStatus}
            onChange={(e) => onStatusChange(e.target.value)}
            className="flex-1 bg-slate-950 border border-slate-800 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 rounded-xl py-2.5 px-3 text-xs text-slate-200 outline-none transition-all"
          >
            <option value="Tất cả">Trạng thái (Tất cả)</option>
            {Object.entries(WARRANTY_STATUS_LABELS).map(([stKey, { label }]) => (
              <option key={stKey} value={stKey}>
                {label}
              </option>
            ))}
          </select>

          {isFiltered && (
            <button
              onClick={onResetFilters}
              className="p-2.5 bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white rounded-xl border border-slate-700 transition-colors shrink-0"
              title="Đặt lại toàn bộ bộ lọc"
            >
              <RotateCcw className="w-4 h-4" />
            </button>
          )}
        </div>
      </div>
    </div>
  )
}
</file>

<file path="app/admin/components/WarrantyFormModal.tsx">
import React, { useState, useEffect } from 'react'
import {
  WarrantyReminder,
  WarrantyStatus,
  WARRANTY_STATUS_LABELS,
  COMMON_LOCATIONS,
  COMMON_SUPPLIERS
} from '../types/warranty'
import { X, Wrench, Save, Calendar, Building, MapPin, AlertCircle, Hash, Smartphone, Tag } from 'lucide-react'

interface WarrantyFormModalProps {
  isOpen: boolean
  editingItem: WarrantyReminder | null
  nextStt: number
  onClose: () => void
  onSave: (data: Partial<WarrantyReminder>) => Promise<void> | void
}

export const WarrantyFormModal: React.FC<WarrantyFormModalProps> = ({
  isOpen,
  editingItem,
  nextStt,
  onClose,
  onSave
}) => {
  const [stt, setStt] = useState<number>(nextStt)
  const [productName, setProductName] = useState('')
  const [productCode, setProductCode] = useState('')
  const [imei, setImei] = useState('')
  const [serialNumber, setSerialNumber] = useState('')
  const [location, setLocation] = useState<string>('Chi nhánh Hải Dương')
  const [customLocation, setCustomLocation] = useState('')
  const [supplier, setSupplier] = useState<string>('Synnex FPT')
  const [customSupplier, setCustomSupplier] = useState('')
  const [receivedDate, setReceivedDate] = useState('')
  const [sentToSupplierDate, setSentToSupplierDate] = useState('')
  const [expectedReturnDate, setExpectedReturnDate] = useState('')
  const [completedDate, setCompletedDate] = useState('')
  const [status, setStatus] = useState<WarrantyStatus>('da_gui_npp')
  const [rmaCode, setRmaCode] = useState('')
  const [cost, setCost] = useState<string>('')
  const [notes, setNotes] = useState('')
  const [loading, setLoading] = useState(false)

  const todayStr = new Date().toISOString().split('T')[0]

  useEffect(() => {
    if (editingItem) {
      setStt(editingItem.stt || 1)
      setProductName(editingItem.productName || '')
      setProductCode(editingItem.productCode || '')
      setImei(editingItem.imei || '')
      setSerialNumber(editingItem.serialNumber || '')

      if ((COMMON_LOCATIONS as readonly string[]).includes(editingItem.location)) {
        setLocation(editingItem.location)
        setCustomLocation('')
      } else {
        setLocation('Khác')
        setCustomLocation(editingItem.location || '')
      }

      if ((COMMON_SUPPLIERS as readonly string[]).includes(editingItem.supplier)) {
        setSupplier(editingItem.supplier)
        setCustomSupplier('')
      } else {
        setSupplier('Khác')
        setCustomSupplier(editingItem.supplier || '')
      }

      setReceivedDate(editingItem.receivedDate || todayStr)
      setSentToSupplierDate(editingItem.sentToSupplierDate || todayStr)
      setExpectedReturnDate(editingItem.expectedReturnDate || '')
      setCompletedDate(editingItem.completedDate || '')
      setStatus(editingItem.status || 'da_gui_npp')
      setRmaCode(editingItem.rmaCode || '')
      setCost(editingItem.cost ? String(editingItem.cost) : '')
      setNotes(editingItem.notes || '')
    } else {
      setStt(nextStt)
      setProductName('')
      setProductCode('')
      setImei('')
      setSerialNumber('')
      setLocation('Chi nhánh Hải Dương')
      setCustomLocation('')
      setSupplier('Synnex FPT')
      setCustomSupplier('')
      setReceivedDate(todayStr)
      setSentToSupplierDate(todayStr)
      setExpectedReturnDate('')
      setCompletedDate('')
      setStatus('da_gui_npp')
      setRmaCode('')
      setCost('')
      setNotes('')
    }
  }, [editingItem, isOpen, nextStt, todayStr])

  if (!isOpen) return null

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault()
    if (!productName.trim() || !serialNumber.trim()) {
      alert('Vui lòng điền Tên sản phẩm và Số Serial Number')
      return
    }

    const finalLocation = location === 'Khác' ? customLocation.trim() || 'Chưa rõ' : location
    const finalSupplier = supplier === 'Khác' ? customSupplier.trim() || 'Chưa rõ' : supplier

    setLoading(true)
    try {
      await onSave({
        stt: Number(stt) || nextStt,
        productName: productName.trim(),
        productCode: productCode.trim() || 'SP-UNKNOWN',
        imei: imei.trim(),
        serialNumber: serialNumber.trim(),
        location: finalLocation,
        supplier: finalSupplier,
        receivedDate: receivedDate || todayStr,
        sentToSupplierDate: sentToSupplierDate || todayStr,
        expectedReturnDate: expectedReturnDate || undefined,
        completedDate: status === 'hoan_thanh' ? (completedDate || todayStr) : undefined,
        status,
        rmaCode: rmaCode.trim() || undefined,
        cost: cost ? Number(cost) : undefined,
        notes: notes.trim()
      })
      onClose()
    } catch (err: any) {
      alert(err.message || 'Lỗi khi lưu phiếu bảo hành')
    } finally {
      setLoading(false)
    }
  }

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-md overflow-y-auto">
      <div className="relative w-full max-w-2xl bg-slate-900 border border-slate-800 rounded-3xl shadow-2xl overflow-hidden my-8 animate-in fade-in zoom-in-95 duration-200">
        {/* Header */}
        <div className="flex items-center justify-between px-6 py-4 border-b border-slate-800 bg-slate-950/60">
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 rounded-2xl bg-indigo-600/20 border border-indigo-500/30 flex items-center justify-center text-indigo-400">
              <Wrench className="w-5 h-5" />
            </div>
            <div>
              <h3 className="text-base font-bold text-white">
                {editingItem ? 'Chỉnh sửa Phiếu Bảo Hành' : 'Tạo Phiếu Nhắc Việc Bảo Hành Mới'}
              </h3>
              <p className="text-xs text-slate-400">
                {editingItem
                  ? `Mã: ${editingItem.productCode} - S/N: ${editingItem.serialNumber}`
                  : 'Ghi nhận thiết bị gửi bảo hành và kích hoạt nhắc nhở sau 7-10 ngày'}
              </p>
            </div>
          </div>
          <button
            onClick={onClose}
            className="p-2 text-slate-400 hover:text-white rounded-xl hover:bg-slate-800 transition-colors"
          >
            <X className="w-5 h-5" />
          </button>
        </div>

        {/* Form Body */}
        <form onSubmit={handleSubmit} className="p-6 space-y-4">
          {/* Row 1: STT & Tên sản phẩm */}
          <div className="grid grid-cols-1 sm:grid-cols-4 gap-3">
            <div className="sm:col-span-1">
              <label className="block text-xs font-semibold text-slate-300 mb-1">
                STT <span className="text-indigo-400">*</span>
              </label>
              <div className="relative">
                <Hash className="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-500" />
                <input
                  type="number"
                  required
                  min={1}
                  value={stt}
                  onChange={(e) => setStt(Number(e.target.value))}
                  className="w-full bg-slate-950 border border-slate-800 focus:border-indigo-500 rounded-xl py-2 pl-9 pr-3 text-xs text-white outline-none"
                />
              </div>
            </div>

            <div className="sm:col-span-3">
              <label className="block text-xs font-semibold text-slate-300 mb-1">
                Tên Sản Phẩm <span className="text-rose-400">*</span>
              </label>
              <input
                type="text"
                required
                value={productName}
                onChange={(e) => setProductName(e.target.value)}
                placeholder="VD: Switch Cisco C1300 24 Port..."
                className="w-full bg-slate-950 border border-slate-800 focus:border-indigo-500 rounded-xl py-2 px-3 text-xs text-white placeholder-slate-500 outline-none"
              />
            </div>
          </div>

          {/* Row 2: Mã Sản Phẩm, Serial Number, IMEI */}
          <div className="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div>
              <label className="block text-xs font-semibold text-slate-300 mb-1">
                Mã Sản Phẩm <span className="text-rose-400">*</span>
              </label>
              <input
                type="text"
                required
                value={productCode}
                onChange={(e) => setProductCode(e.target.value)}
                placeholder="VD: SW-C1300-24T"
                className="w-full bg-slate-950 border border-slate-800 focus:border-indigo-500 rounded-xl py-2 px-3 text-xs text-white placeholder-slate-500 outline-none"
              />
            </div>

            <div>
              <label className="block text-xs font-semibold text-slate-300 mb-1">
                Serial Number (S/N) <span className="text-rose-400">*</span>
              </label>
              <input
                type="text"
                required
                value={serialNumber}
                onChange={(e) => setSerialNumber(e.target.value)}
                placeholder="VD: FOC24190ABC"
                className="w-full bg-slate-950 border border-slate-800 focus:border-indigo-500 rounded-xl py-2 px-3 text-xs text-white placeholder-slate-500 outline-none font-mono"
              />
            </div>

            <div>
              <label className="block text-xs font-semibold text-slate-300 mb-1">
                IMEI (Nếu có)
              </label>
              <input
                type="text"
                value={imei}
                onChange={(e) => setImei(e.target.value)}
                placeholder="VD: 860123456789012"
                className="w-full bg-slate-950 border border-slate-800 focus:border-indigo-500 rounded-xl py-2 px-3 text-xs text-white placeholder-slate-500 outline-none font-mono"
              />
            </div>
          </div>

          {/* Row 3: Nơi gửi về (Location) & Nhà Phân Phối (NPP/Supplier) */}
          <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label className="block text-xs font-semibold text-slate-300 mb-1">
                Nơi gửi về (Location) <span className="text-rose-400">*</span>
              </label>
              <select
                value={location}
                onChange={(e) => setLocation(e.target.value)}
                className="w-full bg-slate-950 border border-slate-800 focus:border-indigo-500 rounded-xl py-2 px-3 text-xs text-white outline-none mb-1.5"
              >
                {COMMON_LOCATIONS.map((loc) => (
                  <option key={loc} value={loc}>
                    {loc}
                  </option>
                ))}
                <option value="Khác">-- Tự nhập nơi gửi khác --</option>
              </select>
              {location === 'Khác' && (
                <input
                  type="text"
                  required
                  value={customLocation}
                  onChange={(e) => setCustomLocation(e.target.value)}
                  placeholder="Nhập địa điểm / chi nhánh gửi về..."
                  className="w-full bg-slate-950 border border-indigo-500/50 rounded-xl py-1.5 px-3 text-xs text-white placeholder-slate-500 outline-none"
                />
              )}
            </div>

            <div>
              <label className="block text-xs font-semibold text-slate-300 mb-1">
                Nhà Phân Phối / NPP <span className="text-rose-400">*</span>
              </label>
              <select
                value={supplier}
                onChange={(e) => setSupplier(e.target.value)}
                className="w-full bg-slate-950 border border-slate-800 focus:border-indigo-500 rounded-xl py-2 px-3 text-xs text-white outline-none mb-1.5"
              >
                {COMMON_SUPPLIERS.map((sup) => (
                  <option key={sup} value={sup}>
                    {sup}
                  </option>
                ))}
                <option value="Khác">-- Tự nhập NPP khác --</option>
              </select>
              {supplier === 'Khác' && (
                <input
                  type="text"
                  required
                  value={customSupplier}
                  onChange={(e) => setCustomSupplier(e.target.value)}
                  placeholder="Nhập tên nhà cung cấp / NPP..."
                  className="w-full bg-slate-950 border border-indigo-500/50 rounded-xl py-1.5 px-3 text-xs text-white placeholder-slate-500 outline-none"
                />
              )}
            </div>
          </div>

          {/* Row 4: Ngày tiếp nhận, Ngày mang qua NPP, Ngày dự kiến trả */}
          <div className="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div>
              <label className="block text-xs font-semibold text-slate-300 mb-1">
                Ngày tiếp nhận về kho
              </label>
              <input
                type="date"
                value={receivedDate}
                onChange={(e) => setReceivedDate(e.target.value)}
                className="w-full bg-slate-950 border border-slate-800 focus:border-indigo-500 rounded-xl py-2 px-3 text-xs text-white outline-none"
              />
            </div>

            <div>
              <label className="block text-xs font-semibold text-slate-300 mb-1">
                Ngày mang qua NPP <span className="text-indigo-400">* (Tính hạn)</span>
              </label>
              <input
                type="date"
                required
                value={sentToSupplierDate}
                onChange={(e) => setSentToSupplierDate(e.target.value)}
                className="w-full bg-slate-950 border border-indigo-500/50 rounded-xl py-2 px-3 text-xs text-white outline-none"
              />
            </div>

            <div>
              <label className="block text-xs font-semibold text-slate-300 mb-1">
                Ngày hẹn trả dự kiến
              </label>
              <input
                type="date"
                value={expectedReturnDate}
                onChange={(e) => setExpectedReturnDate(e.target.value)}
                className="w-full bg-slate-950 border border-slate-800 focus:border-indigo-500 rounded-xl py-2 px-3 text-xs text-white outline-none"
              />
            </div>
          </div>

          {/* Row 5: Trạng thái & Mã phiếu RMA */}
          <div className="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div>
              <label className="block text-xs font-semibold text-slate-300 mb-1">
                Trạng thái xử lý <span className="text-rose-400">*</span>
              </label>
              <select
                value={status}
                onChange={(e) => setStatus(e.target.value as WarrantyStatus)}
                className="w-full bg-slate-950 border border-slate-800 focus:border-indigo-500 rounded-xl py-2 px-3 text-xs text-white outline-none"
              >
                {Object.entries(WARRANTY_STATUS_LABELS).map(([k, { label }]) => (
                  <option key={k} value={k}>
                    {label}
                  </option>
                ))}
              </select>
            </div>

            <div>
              <label className="block text-xs font-semibold text-slate-300 mb-1">
                Mã phiếu NPP (RMA No.)
              </label>
              <input
                type="text"
                value={rmaCode}
                onChange={(e) => setRmaCode(e.target.value)}
                placeholder="VD: RMA-FPT-89421"
                className="w-full bg-slate-950 border border-slate-800 focus:border-indigo-500 rounded-xl py-2 px-3 text-xs text-white placeholder-slate-500 outline-none font-mono"
              />
            </div>

            <div>
              <label className="block text-xs font-semibold text-slate-300 mb-1">
                Chi phí bảo hành (VNĐ)
              </label>
              <input
                type="number"
                min={0}
                value={cost}
                onChange={(e) => setCost(e.target.value)}
                placeholder="VD: 500000"
                className="w-full bg-slate-950 border border-slate-800 focus:border-indigo-500 rounded-xl py-2 px-3 text-xs text-white placeholder-slate-500 outline-none font-mono"
              />
            </div>
          </div>

          {/* Row 6: Ghi chú tình trạng lỗi */}
          <div>
            <label className="block text-xs font-semibold text-slate-300 mb-1">
              Mô tả tình trạng lỗi & Ghi chú
            </label>
            <textarea
              rows={3}
              value={notes}
              onChange={(e) => setNotes(e.target.value)}
              placeholder="VD: Mất nguồn đột ngột, chớp đèn cổng quang port 24, gửi kèm adapter nguồn..."
              className="w-full bg-slate-950 border border-slate-800 focus:border-indigo-500 rounded-xl py-2 px-3 text-xs text-white placeholder-slate-500 outline-none resize-none"
            />
          </div>

          {/* Footer Actions */}
          <div className="flex items-center justify-end gap-3 pt-3 border-t border-slate-800">
            <button
              type="button"
              onClick={onClose}
              className="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-750 text-slate-300 text-xs font-semibold transition-colors"
            >
              Hủy bỏ
            </button>
            <button
              type="submit"
              disabled={loading}
              className="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow-lg shadow-indigo-600/30 transition-all flex items-center gap-2 disabled:opacity-50"
            >
              {loading ? (
                <span className="w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin" />
              ) : (
                <Save className="w-4 h-4" />
              )}
              <span>{editingItem ? 'Lưu thay đổi' : 'Tạo phiếu bảo hành'}</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  )
}
</file>

<file path="app/admin/components/WarrantyStats.tsx">
import React from 'react'
import { WarrantyStats as WarrantyStatsType } from '../types/warranty'
import { Wrench, Clock, AlertTriangle, AlertCircle, CheckCircle2 } from 'lucide-react'

interface WarrantyStatsProps {
  stats: WarrantyStatsType
}

export const WarrantyStats: React.FC<WarrantyStatsProps> = ({ stats }) => {
  return (
    <div className="grid grid-cols-2 md:grid-cols-5 gap-3.5 mb-6">
      {/* 1. Tổng thiết bị bảo hành */}
      <div className="bg-slate-900/80 border border-slate-800/80 rounded-2xl p-4 flex flex-col justify-between hover:border-slate-700 transition-all shadow-lg shadow-black/20">
        <div className="flex items-center justify-between mb-2">
          <span className="text-[11px] font-semibold text-slate-400">Tổng phiếu</span>
          <div className="w-8 h-8 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400">
            <Wrench className="w-4 h-4" />
          </div>
        </div>
        <div>
          <div className="text-2xl font-bold text-white tracking-tight">{stats.total}</div>
          <p className="text-[11px] text-slate-400 mt-0.5">Toàn bộ thiết bị tiếp nhận</p>
        </div>
      </div>

      {/* 2. Đang ở NPP */}
      <div className="bg-slate-900/80 border border-slate-800/80 rounded-2xl p-4 flex flex-col justify-between hover:border-slate-700 transition-all shadow-lg shadow-black/20">
        <div className="flex items-center justify-between mb-2">
          <span className="text-[11px] font-semibold text-sky-400">Đang ở NPP</span>
          <div className="w-8 h-8 rounded-xl bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-400">
            <Clock className="w-4 h-4" />
          </div>
        </div>
        <div>
          <div className="text-2xl font-bold text-sky-400 tracking-tight">{stats.inNpp}</div>
          <p className="text-[11px] text-slate-400 mt-0.5">NPP đang sửa chữa</p>
        </div>
      </div>

      {/* 3. Cảnh báo (7 - 10 ngày) */}
      <div className="bg-slate-900/80 border border-amber-500/30 rounded-2xl p-4 flex flex-col justify-between hover:border-amber-500/50 transition-all shadow-lg shadow-amber-500/5 bg-gradient-to-br from-amber-500/5 to-transparent">
        <div className="flex items-center justify-between mb-2">
          <span className="text-[11px] font-semibold text-amber-300 flex items-center gap-1">
            <AlertTriangle className="w-3.5 h-3.5" />
            Cảnh báo (7-10d)
          </span>
          <div className="w-8 h-8 rounded-xl bg-amber-500/20 border border-amber-500/30 flex items-center justify-center text-amber-400">
            <AlertTriangle className="w-4 h-4" />
          </div>
        </div>
        <div>
          <div className="text-2xl font-bold text-amber-300 tracking-tight">{stats.warningCount}</div>
          <p className="text-[11px] text-amber-300/80 mt-0.5 font-medium">Cần gọi giục tiến độ</p>
        </div>
      </div>

      {/* 4. Quá hạn (> 10 ngày) */}
      <div className="bg-slate-900/80 border border-rose-500/40 rounded-2xl p-4 flex flex-col justify-between hover:border-rose-500/60 transition-all shadow-lg shadow-rose-500/10 bg-gradient-to-br from-rose-500/10 to-transparent">
        <div className="flex items-center justify-between mb-2">
          <span className="text-[11px] font-semibold text-rose-300 flex items-center gap-1">
            <AlertCircle className="w-3.5 h-3.5 animate-bounce" />
            Quá hạn (&gt;10d)
          </span>
          <div className="w-8 h-8 rounded-xl bg-rose-500/20 border border-rose-500/30 flex items-center justify-center text-rose-400">
            <AlertCircle className="w-4 h-4" />
          </div>
        </div>
        <div>
          <div className="text-2xl font-bold text-rose-400 tracking-tight">{stats.overdueCount}</div>
