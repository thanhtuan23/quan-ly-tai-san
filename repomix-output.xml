            onStatusChange={setSelectedWarrantyStatus}
            searchTerm={warrantySearchTerm}
            onSearchChange={setWarrantySearchTerm}
            locationOptions={warrantyLocationsList}
            supplierOptions={warrantySuppliersList}
            onResetFilters={() => {
