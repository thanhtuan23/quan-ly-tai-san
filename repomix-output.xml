  canViewReports: boolean            // Xem Dashboard Hologram & Báo cáo Ngày/Tuần/Tháng
  canManageUsers: boolean            // Quản lý tài khoản & phân quyền
  canManageSettings: boolean         // Cài đặt Module & Telegram Bot
}

